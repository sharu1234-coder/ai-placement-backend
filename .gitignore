*.py[cod]
*.egg-info/
# Matches .venv, .venv312, .venv-py313, ... -- the bare `.venv/` rule silently failed to
# cover a second, version-suffixed environment, which is exactly what gets created when
# upgrading interpreters.
.venv*/
venv/
env/

.env
*.db
*.sqlite3
/uploads/

.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

.vscode/
.idea/

# Local backup output (scripts/backup_db.py) -- never commit a database dump.
/backups/
