__pycache__/
*.py[cod]
*.egg-info/
# Matches .venv, .venv312, .venv-py313, ... -- the bare `.venv/` rule silently failed to
# cover a second, version-suffixed environment, which is exactly what gets created when
# upgrading interpreters.
.venv*/
venv/
env/

.env
# Backups and local variants of .env hold the same live credentials as .env itself.
# .env.bak-203116 was found holding a real Razorpay key and secret, a GitHub OAuth client
# secret and the token encryption key, while being untracked-but-NOT-ignored -- one blanket
# `git add` away from being published. Only .env.example, which holds placeholders, is tracked.
.env.*
!.env.example
*.db
*.sqlite3
/uploads/

.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

.vscode/
.idea/

# Local backup output (scripts/backup_db.py) -- never commit a database dump.
/backups/
