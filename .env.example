# Copy to .env and override for local/prod. Never commit the real .env.

APP_NAME=AI Placement OS Backend
ENVIRONMENT=development
DEBUG=true

# SQLite for local dev (default). Production: a PostgreSQL URL, e.g.
# postgresql://<user>:<password>@<host>:5432/<dbname> -- driver (psycopg2-binary) is
# already in requirements.txt, and app/database/session.py's engine setup is already
# driver-agnostic (the SQLite-only check_same_thread arg is conditional on the URL
# scheme). Never hardcode real credentials here or anywhere in source control --
# production sets this via the deployment platform's secret store.
DATABASE_URL=sqlite:///./app.db

# Required before any real deployment. Deliberately EMPTY rather than a placeholder: copying
# this file and forgetting this line must fail startup, not quietly sign tokens with a value
# that is published in this repository. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI_PROVIDER=ollama for dev, AI_PROVIDER=anthropic for production -- swapping this one
# value (plus ANTHROPIC_API_KEY below) is the entire migration; no service/route changes.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# Increase if large structured-output calls (e.g. a 90-day roadmap) time out on slower hardware.
OLLAMA_TIMEOUT_SECONDS=240

# Required only when AI_PROVIDER=anthropic. Get a key at https://console.anthropic.com/ --
# never commit a real key; set it in your deployment platform's secret store instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Increase if a given deployment sees timeouts on slow/large structured-output calls.
ANTHROPIC_TIMEOUT_SECONDS=120

# Dev-only local speech-to-text model size for OllamaProvider.transcribe (tiny.en/base.en/
# small.en/...) -- swap AI_PROVIDER's STT path for a cloud provider before real user testing.
WHISPER_MODEL_SIZE=tiny.en

# VA-3 provider-neutral speech layer (app/speech). Separate from AI_PROVIDER on purpose: the
# text provider and the speech providers are chosen independently, and the text features must
# keep working with speech switched off -- which is what "none" means here.
#
# STT_PROVIDER=none | faster-whisper       TTS_PROVIDER=none | pyttsx3
#
# Both default to "none" because no provider has been measured well enough to be a production
# default. faster-whisper is CPU-only here and pyttsx3 depends on a host speech engine; see
# docs/speech-provider-evaluation.md for the measurements and the open questions.
STT_PROVIDER=none
TTS_PROVIDER=none

# Which voice the local speech driver speaks with: "female", "male", or "system" to keep the
# host default. "female" matches the specified voice companion.
#
# This setting had no effect on the Voice Career Coach until 2026-10-19. Selection lived only
# on the AI-provider path, while the coach resolves its synthesiser from TTS_PROVIDER and
# reached an adapter that never asked for a voice -- so it used the host default, which on a
# typical Windows host is "Microsoft David Desktop", a male voice. See section 9 of
# docs/speech-provider-evaluation.md.
TTS_VOICE_GENDER=female

# What to do when the configured voice cannot be selected -- usually because it is not
# installed on the host.
#
# false (default) speaks with the host default anyway: a student would rather hear the wrong
# voice than silence. The fallback is logged as a WARNING and reported by
# `python -m scripts.voice_diagnostics` either way.
#
# true makes it a typed error instead. Set it where speaking in the wrong voice is worse than
# failing the turn.
TTS_VOICE_REQUIRED=false

# Speaking rate in words per minute, or 0 to keep the driver default.
#
# 0, because the default was measured and is already conversational: 167 wpm on the
# development host with Zira, against a normal range of about 150-180. Tune it only after
# somebody has actually listened.
TTS_VOICE_RATE=0

UPLOAD_DIR=uploads

# STORAGE_PROVIDER=local for dev (writes under UPLOAD_DIR). STORAGE_PROVIDER=s3 for
# production -- works against real AWS S3 or any S3-compatible service (Cloudflare R2,
# MinIO, Backblaze B2, DigitalOcean Spaces, ...); leave STORAGE_S3_ENDPOINT_URL unset for
# AWS, or point it at the chosen provider's endpoint. Never commit real credentials here.
STORAGE_PROVIDER=local
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT_URL=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# EMAIL_PROVIDER=console for dev (logs the password-reset code instead of sending real
# email -- see server logs). EMAIL_PROVIDER=smtp for production -- works with any
# SMTP-speaking service (Gmail app passwords, SendGrid/SES/Postmark/Mailgun SMTP relays,
# ...). Never commit real credentials here.
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15

# Host header allowlist (TrustedHostMiddleware). "*" (dev default) accepts any Host.
# Production should list the real domain(s), comma-separated, e.g.
# ALLOWED_HOSTS=api.aiplacementos.com. TLS itself is terminated at the reverse proxy /
# deployment platform, not by this app -- see README "HTTPS / network security".
ALLOWED_HOSTS=*

# Razorpay TEST MODE credentials (Settings > API Keys > Test Mode in the Razorpay dashboard).
# Leave unset to keep subscriptions disabled -- /subscriptions/checkout fails loudly with a
# clear 503 rather than silently trying an empty auth header. RAZORPAY_KEY_SECRET is never
# sent to the Android client; only RAZORPAY_KEY_ID is (Razorpay's Checkout SDK needs the
# publishable key id client-side). Use rzp_test_... keys until Razorpay's own onboarding/KYC
# process clears this account for live (rzp_live_...) keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Separate secret configured independently in the Razorpay dashboard's Webhooks section --
# used only to verify inbound POST /subscriptions/webhook calls. Leave unset to keep that
# route fail-closed (503); the checkout-callback flow (POST /subscriptions/verify) remains
# the primary activation path either way.
RAZORPAY_WEBHOOK_SECRET=

# Firebase App Check (see app/core/app_check.py) -- confirms requests come from the real
# Android app, not a scripted client with a stolen bearer token. Leave false until BOTH of
# these are true: (1) a Firebase service account JSON is available and
# GOOGLE_APPLICATION_CREDENTIALS points at it (the standard Google Application Default
# Credentials variable -- not set here, since every other Google/Firebase client library
# already reads it the same way), and (2) the deployed Android app version actually sends
# the X-Firebase-AppCheck header (NetworkModule.kt's AppCheckInterceptor). Flipping this on
# before both are true will reject every request with 401.
FIREBASE_APP_CHECK_ENABLED=false

# JOB_PROVIDER selects the Job Hunt job source: "none" (default), "jobvetta", "adzuna" or
# "careerjet". "none" is a real state, not a broken one -- Job Hunt answers 503 and the app
# shows "Job Hunt isn't available yet", which is honest. It must never be made to return an
# empty list instead, because that would be a claim about the job market.
#
# Jobvetta: https://api.jobvetta.com/v1, India-only coverage, and a hard limit of 50 requests
# per key per UTC day for the WHOLE deployment. That ceiling belongs to the key, not to any
# student's plan -- a premium subscription buys unlimited Job Hunt, not unlimited provider
# calls, and the two are enforced separately (app/services/job_hunt/entitlement.py versus
# app/services/job_hunt/provider_budget.py). Leave the key blank and the provider stays
# disabled; never commit a real key, and never put a placeholder value here, because a
# placeholder makes an unconfigured deployment look configured.
JOB_PROVIDER=none
JOBVETTA_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
CAREERJET_AFFID=
CAREERJET_LOCALE_CODE=en_IN

# --- Professional Presence (GitHub / LinkedIn connections) ---------------------------
# Encrypts provider access tokens and PKCE verifiers at rest (app/core/token_crypto.py).
# Leave BLANK here and set a real value only in the deployment environment. A placeholder
# would be a published encryption key -- the same defect JWT_SECRET_KEY once shipped with,
# and the reason every secret in this file is now empty rather than filled in.
#
# Unset is a legitimate state: Professional Presence reports itself unavailable and stores
# no credentials. Set-but-malformed is refused at startup, because that failure would
# otherwise land only AFTER a student had already authorised on the provider.
#
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# GitHub OAuth for Professional Presence. Leave BLANK here; set real values only in the
# deployment environment. The client secret exists ONLY on the backend -- the Android app
# receives a finished authorization URL from this server and never holds a secret it could
# leak by being decompiled.
#
# Both unset = the feature reports itself unavailable, which is a legitimate state. Half-
# configured is refused at startup, because that failure would otherwise land only AFTER a
# student had already approved the consent screen on GitHub.
#
# Scope is deliberately EMPTY: GitHub grants read-only access to public profile and repository
# information with no scope at all, which is the whole V1 requirement. Never request
# public_repo -- despite the name it is read/WRITE on public repositories.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must match the callback URL registered on the GitHub OAuth App exactly, and must be https in
# production -- the authorization code travels as a query parameter on it.
# e.g. https://api.example.com/professional-presence/connections/github/callback
GITHUB_OAUTH_REDIRECT_URI=
# Where the callback returns the browser to hand control back to the app. Carries a result
# only -- never a token, code, state or verifier.
PROFESSIONAL_PRESENCE_APP_REDIRECT=aiplacementos://presence/callback
