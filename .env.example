# Copy to .env and override for local/prod. Never commit the real .env.

APP_NAME=AI Placement OS Backend
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=sqlite:///./app.db

# Required override before any real deployment.
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI_PROVIDER=ollama is the only implementation so far (dev). A CloudProvider is added
# when a production AI service is chosen -- see PROJECT_HANDOFF.md section 8.6.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

UPLOAD_DIR=uploads
