# Copy to .env and override for local/prod. Never commit the real .env.

APP_NAME=AI Placement OS Backend
ENVIRONMENT=development
DEBUG=true

# SQLite for local dev (default). Production: a PostgreSQL URL, e.g.
# postgresql://<user>:<password>@<host>:5432/<dbname> -- driver (psycopg2-binary) is
# already in requirements.txt, and app/database/session.py's engine setup is already
# driver-agnostic (the SQLite-only check_same_thread arg is conditional on the URL
# scheme). Never hardcode real credentials here or anywhere in source control --
# production sets this via the deployment platform's secret store.
DATABASE_URL=sqlite:///./app.db

# Required override before any real deployment.
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI_PROVIDER=ollama for dev, AI_PROVIDER=anthropic for production -- swapping this one
# value (plus ANTHROPIC_API_KEY below) is the entire migration; no service/route changes.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# Increase if large structured-output calls (e.g. a 90-day roadmap) time out on slower hardware.
OLLAMA_TIMEOUT_SECONDS=240

# Required only when AI_PROVIDER=anthropic. Get a key at https://console.anthropic.com/ --
# never commit a real key; set it in your deployment platform's secret store instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

UPLOAD_DIR=uploads
